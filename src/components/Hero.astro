---
const ctas = [
  { href: 'https://github.com/alicoding', label: 'GitHub', primary: true },
  { href: 'https://www.linkedin.com/in/aldallal.ali', label: 'LinkedIn', primary: false },
  { href: 'https://x.com/alicoding', label: 'X', primary: false },
  { href: 'mailto:ali@alicoding.com', label: 'Email', primary: false },
];
---

<div class="hero">
  <img src="/images/profile.jpeg" alt="Ali Al Dallal" />
  <h1>Ali Al Dallal</h1>
  <div class="role">
    Principal Engineer at <a class="co" href="#path-tangerine">Tangerine</a>
  </div>
  <p class="lede">
    I lead the <strong>onboarding domain</strong> at{' '}
    <a class="co" href="#path-tangerine">Tangerine</a> — the systems people use to become Clients.
    Before that: nine years at{' '}
    <a class="co" href="#path-scotiabank"><strong>Scotiabank</strong></a> and three at{' '}
    <a class="co" href="#path-mozilla"><strong>Mozilla</strong></a>. I build developer tools in the
    open; lately they are all about working with AI agents without giving up the human gate.
  </p>
  <div class="cta">
    {
      ctas.map((cta) => (
        <a class={cta.primary ? 'btn primary' : 'btn'} href={cta.href}>
          {cta.label}
        </a>
      ))
    }
  </div>
</div>
